{
  "profile": {
    "name": "dev_agent_directed",
    "risk_level": "development",
    "description": "Explicit local development profile. Use only with ARsim or an isolated lab runtime."
  },
  "access_policy": {
    "mode": "agent_directed",
    "allow_dynamic_pvi_read": true,
    "allow_dynamic_pvi_write": true,
    "allow_dynamic_opcua_read": true,
    "allow_dynamic_opcua_write": false,
    "allowed_target_roles": [
      "arsim"
    ],
    "blocked_name_patterns": [
      "*safety*",
      "*safeio*",
      "*physicalio*",
      "*iomap*",
      "*system*",
      "sys:*"
    ],
    "catalog_path": "var/catalogs/plc_symbol_catalog.json"
  },
  "opcua": {
    "auto_expose_all": false,
    "exposure_mode": "agent_directed",
    "verify_after_download": false,
    "endpoint_port": 4840,
    "validation_node_ids": []
  },
  "pvi": {
    "enabled": true,
    "verify_after_download": false,
    "read_whitelist": [],
    "write_whitelist": [],
    "restore_writes": [],
    "validation_variables": []
  },
  "logger": {
    "enabled": true,
    "default_format": ".html",
    "allowed_modules": [
      {
        "type": "System",
        "name": "$arlogsys"
      }
    ],
    "blocked_modules": [
      {
        "type": "Safety",
        "name": "$safety"
      }
    ]
  },
  "targets": {
    "arsim": {
      "ip": "127.0.0.1",
      "role": "arsim",
      "allow_auto_download": true,
      "arsim_loader_exe": "PrintDemo\\Temp\\Simulation\\x1685\\X20CP1685\\ar000loader.exe"
    }
  }
}
